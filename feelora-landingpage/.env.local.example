# Copy to .env.local and fill in values
# Vite loads .env.local automatically

# Enable local auth (skips OAuth, uses mock user + test token)
VITE_AUTH_MODE=local

# Auth token for API calls (get from team or Cognito)
VITE_TEST_AUTH_TOKEN=<paste-token-here>

# Mock user groups — controls routing (patient/therapist/pending)
# Options: type:U (patient), type:T (therapist), type:P (pending therapist)
VITE_LOCAL_USER_GROUPS=type:U

# Backend GraphQL endpoint
VITE_GRAPHQL_API_URL=https://graphql.feelora-dev.com/graphql
